# =============================================================================
# Cấu hình cho docker compose (Jenkins + SonarQube). Sao chép thành .env
# Trên EC2, user-data đã tạo sẵn /opt/lab2/cau3-jenkins/jenkins/.env và điền
# các giá trị tự động; bạn chỉ cần điền phần "BẮT BUỘC".
# =============================================================================

# ----- BẮT BUỘC -----
# Docker Hub: Account settings > Personal access tokens > Read & Write
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
# SonarQube yêu cầu >= 12 ký tự, có chữ hoa, chữ thường, chữ số và ký tự đặc biệt
SONAR_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# ----- TỰ ĐỘNG (bootstrap.sh / user-data điền) -----
SONAR_TOKEN=
JWT_KEY=
DOCKER_GID=
K3S_HOST=
JENKINS_URL=
LAB_REPO_URL=
LAB_REPO_BRANCH=main
